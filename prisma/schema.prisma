// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model OdooConnection {
  id                   String   @id @default(cuid())
  shop                 String   @unique
  odooUrl              String
  database             String
  apiKey               String
  active               Boolean  @default(true)
  lastTestedAt         DateTime?
  // Cursor for the scheduled inventory pull - only variants with quant
  // activity since this timestamp are re-queried on the next tick, so
  // an idle catalog doesn't get fully recomputed every poll.
  lastInventorySyncAt  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SyncMapping {
  id           String   @id @default(cuid())
  shop         String
  resourceType String
  shopifyId    String
  odooModel    String
  odooId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, resourceType, shopifyId])
  @@index([shop, resourceType])
}

model SyncEvent {
  id          String    @id @default(cuid())
  webhookId   String    @unique
  shop        String
  topic       String
  resourceId  String?
  status      String    @default("PROCESSING")
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  // How many times the scheduled retry job has attempted this failed
  // event, and when it last tried - caps automatic retries so a
  // permanently-broken event (bad payload, deleted Shopify resource)
  // doesn't get retried forever.
  retryCount  Int       @default(0)
  lastRetryAt DateTime?

  @@index([shop, createdAt])
  @@index([shop, status])
}
