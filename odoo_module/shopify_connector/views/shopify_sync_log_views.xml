<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_sync_log_list" model="ir.ui.view">
        <field name="name">shopify.sync.log.list</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <list string="Shopify Sync Log" default_order="create_date desc" create="false" edit="false">
                <field name="create_date" string="When"/>
                <field name="shopify_shop"/>
                <field name="resource_type"/>
                <field name="method"/>
                <field name="action"/>
                <field name="shopify_id"/>
                <field name="odoo_model"/>
                <field name="odoo_res_id"/>
                <field name="duration_ms"/>
                <field name="status" decoration-danger="status == 'error'" decoration-success="status == 'success'" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_sync_log_form" model="ir.ui.view">
        <field name="name">shopify.sync.log.form</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <form string="Shopify Sync Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="shopify_shop"/>
                            <field name="resource_type"/>
                            <field name="shopify_id"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="action"/>
                            <field name="odoo_model"/>
                            <field name="odoo_res_id"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Error" invisible="status == 'success'">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_sync_log" model="ir.actions.act_window">
        <field name="name">Shopify Sync Log</field>
        <field name="res_model">shopify.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shopify_connector_root" name="Shopify Connector" sequence="90" groups="base.group_system"/>
    <menuitem id="menu_shopify_sync_log" name="Sync Log" parent="menu_shopify_connector_root" action="action_shopify_sync_log" sequence="10"/>
</odoo>
